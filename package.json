{
  "name": "zhaozhou",
  "version": "0.0.1",
  "private": true,
  "description": "Zhaozhou FPGA game console — compiler + tooling workspaces (npm lane; C++/RTL build is CMake)",
  "workspaces": [
    "compiler",
    "tools/abi-gen",
    "tools/ledger",
    "tools/fixgen"
  ],
  "scripts": {
    "test": "echo [placeholder] root test aggregation lands in W6",
    "ledger:check": "npm run -w tools/ledger check",
    "ledger:gen": "npm run -w tools/ledger gen",
    "tables:check": "npm run -w tools/fixgen check",
    "tables:gen": "npm run -w tools/fixgen gen",
    "abi:check": "npm run -w tools/abi-gen check",
    "abi:gen": "npm run -w tools/abi-gen gen"
  },
  "engines": {
    "node": ">=20"
  }
}
