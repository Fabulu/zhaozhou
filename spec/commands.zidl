// commands.zidl — Zhaozhou command ABI, single source of truth (charter 19/29-5).
//
// Grammar: EBNF in P5 recon (RUN-20260814-1852-wave1-abi-capture FINDINGS 1.2),
// normatively restated in spec/capture_format.md 1. Two ratified extensions
// over that EBNF (both documented there):
//   * command status keyword: `command <name> <opcode> implemented|reserved`
//     — implemented commands are executed by the decoder/shell; reserved
//     commands have a FROZEN wire layout but no execution semantics yet
//     (their records still validate structurally). Since ABI v2 (wave 2)
//     this includes debug-umbrella opcodes (never game-facing; the header
//     flags-bit0 rule is unchanged).
//   * `enum` entries may carry a trailing doc comment via `//` (lexical).
//
// Fixed-point fields reference spec/qformats.md (W3): `fx16` is a Q16.16
// value carried in a 4-byte (int32) container — 16 fractional bits, 16
// integer bits, little-endian on the wire. All other Q formats live there.
//
// Opcode ranges (plan 1.E / P5 1.2, table-derived):
//   0x0000-0x00FF  frame control, views, presentation
//   0x0200-0x02FF  terrain / surface (semantic, reserved in Phase 1)
//   0x0300-0x03FF  forms / populations / procedural (reserved in Phase 1)
//   0x0400-0x04FF  audio (reserved in Phase 1)
//   0xF000-0xF0FF  bootstrap/debug umbrella — never game-facing; any frame
//                  containing one of these opcodes MUST set frame header
//                  flags bit0 contains_debug_commands (ZH_ABI_DEBUG_FLAG_REQUIRED)
//
// This file is the ABI. Generated C++/TS/SV byte-identity is enforced by
// tools/abi-gen goldens; editing layout here requires regenerating
// (`npm run abi:gen`) and re-committing every generated artifact.

abi zhao {
  version 2
  endian little
  command_alignment 16
  opcode_width u16
}

// Frame-slot bound (plan 1.E): provisional until Phase 2 measurements;
// every validator bound-checks against this constant, never a magic number.
const u32 FRAME_SLOT_BYTES = 1048576;

// Numeric-law version (spec/qformats.md §13): travels with the ABI so capture
// replay can refuse mismatched numerics. Bump on any frozen Q-format change.
const u16 QFMT_VERSION = 1;

// Error codes — generated verbatim into C++/TS/SV and shared by the frame
// validator (spec/capture_format.md 4.2), the .zcap tools, and the stub RTL.
// Order matters: it is the fail-safe validation order of capture_format.md.
// Values 0-11 are the P5 3.3 set; 12-14 are wave-1 ratifications (1.E).
enum zhao_abi_error : u32 {
  ZH_ABI_OK = 0;                     // frame accepted
  ZH_ABI_BAD_MAGIC = 1;              // frame magic mismatch
  ZH_ABI_BAD_ABI_VERSION = 2;        // abi_version != generated ABI version
  ZH_ABI_RESERVED_FLAG = 3;          // undefined flag bit set (frame or record)
  ZH_ABI_BAD_LENGTH = 4;             // lengths misaligned / out of bounds
  ZH_ABI_BAD_HEADER_CRC = 5;         // header_crc32c mismatch
  ZH_ABI_BAD_PAYLOAD_CRC = 6;        // payload_crc32c mismatch
  ZH_ABI_UNKNOWN_OPCODE = 7;         // opcode not in the generated table
  ZH_ABI_RESERVED_FIELD = 8;         // reserved/pad byte nonzero on the wire
  ZH_ABI_BAD_VALUE = 9;              // enum/bitfield out of range (none in v1)
  ZH_ABI_STALE_HANDLE = 10;          // handle generation mismatch (none in v1)
  ZH_ABI_TRUNCATED = 11;             // records end before command_bytes
  ZH_ABI_DEBUG_FLAG_REQUIRED = 12;   // 0xF00n opcode without header flags bit0
  ZH_ABI_COUNT_MISMATCH = 13;        // records walked != command_count
  ZH_ABI_UNIMPLEMENTED_COMMAND = 14; // executor-level: reserved opcode used
}

// ---- value enums (ABI v2, wave 2) -------------------------------------------

// Presentation/video mode — the ONE mode selector machine-wide (plan D6).
// Wire-identical with the Phase-1 `u8 mode` of SetPresentationContract and
// the .zcap FRAMEBUFFER_EXPECTED `mode` byte; RTL latches it only at frame
// start (vblank) — effective next frame, never mid-frame (spec/video_rules.md).
enum video_mode : u8 {
  VIDEO_Z60 = 0;    // 384x240, canvas 184,320 B RGB565
  VIDEO_STORM = 1;  // 320x240, canvas 153,600 B RGB565
  VIDEO_DUO = 2;   // 512x240 (2 x 256x192), canvas 245,760 B RGB565
}

// ---- composed fixed-point containers (element = fx16, Q16.16, spec/qformats.md)

// Axis-aligned footprint in world units.
struct rectfx {
  fx16 x0;
  fx16 y0;
  fx16 x1;
  fx16 y1;
}

// Affine 2D transform: translation then row-major 2x2.
struct transform2fx {
  fx16 tx;
  fx16 ty;
  fx16 r00;
  fx16 r01;
  fx16 r10;
  fx16 r11;
}

// Row-major 4x4 view-projection matrix.
struct mat4fx {
  fx16 m00;
  fx16 m01;
  fx16 m02;
  fx16 m03;
  fx16 m10;
  fx16 m11;
  fx16 m12;
  fx16 m13;
  fx16 m20;
  fx16 m21;
  fx16 m22;
  fx16 m23;
  fx16 m30;
  fx16 m31;
  fx16 m32;
  fx16 m33;
}

// ---- controller (plan D5): the canonical pad snapshot ------------------------
//
// ONE definition machine-wide: the .zcap CONTROLLER_SNAPSHOT (0x0004) entry
// IS this struct; abi-gen emits it into C++/TS/SV and fpga/rtl/common/
// zhao_pkg.sv re-exports the generated SV type.
//
// Size reconciliation (plan D5 said "24 B, 4-aligned"; the shipped .zcap
// 0x0004 layout is 20 B): the .zidl grammar (capture_format.md 1.1 rule 3)
// caps element alignment at 4 — a 4-byte `buttons` inside every array
// element requires a stride divisible by 4. The declared fields of the
// shipped section sum to 18 B; one explicit 4-byte reserved word closes the
// struct at exactly 20 B, already 4-aligned. 24 B would NOT be
// wire-compatible with the shipped 0x0004 section, and the grammar forbids
// the hidden 2-4 tail bytes a 24-B layout would need. DECISION: 20 B
// (u32 rsv), array stride 20. Law: spec/input_rules.md.
struct PadFrame {
  u8 pad_index;   // 0-3 (four slots, charter 17)
  u8 flags;       // bit0 = pad_present; bits 1-7 reserved 0
  u16 sequence;   // per-pad monotonic snapshot sequence
  u32 buttons;    // 32 digital bits (bit i = button i, active high)
  i16 lx;         // left stick X,  signed, center 0
  i16 ly;         // left stick Y,  signed, center 0, positive = down
  i16 rx;         // right stick X, signed, center 0
  i16 ry;         // right stick Y, signed, center 0, positive = down
  u32 rsv;        // reserved, must be 0 (closes the struct at 20 B / stride 4)
}

// ---- frame control ---------------------------------------------------------

command Nop 0x0000 implemented {
  // decoder test vehicle; record = bare 16-byte command header
}

command BeginFrame 0x0001 implemented {
  u32 frame_id;
  u32 resource_epoch;
  u32 flags;
  u32 deadline_cycles;
}

command EndFrame 0x0002 implemented {
  u32 completion_flags;
  u32 expected_crc_valid;
  u32 expected_framebuffer_crc;
  pad[4];
}

// ---- views / presentation --------------------------------------------------

command SetView 0x0010 implemented {
  u8 view_id;
  u8 viewport_id;
  u16 flags;
  mat4fx view_projection;
  fx16 pixel_error;
  u32 geometry_tokens;
  u32 fragment_tokens;
}

command SetPresentationContract 0x0020 implemented {
  video_mode mode;  // ABI v2: was `u8 mode` — wire-identical (1 byte, same offset)
  u8 view_count;
  u16 flags;
  u32 geometry_tokens[2];
  u32 fragment_tokens[2];
  u32 shared_tokens;
  pad[8];
}

// ---- terrain / surface (semantic commands; layouts frozen, execution reserved)

command TerrainField 0x0200 reserved {
  handle32[program] program;
  rectfx footprint;
  u32 start_tick;
  u32 duration_ticks;
  u8 parameters[64];
  pad[4];
}

command SurfaceStamp 0x0210 reserved {
  handle32[brush] brush;
  handle32[patch] patch;
  u8 operation;
  u8 tag;
  u16 strength;
  transform2fx transform;
  pad[12];
}

// ---- forms / populations / procedural (reserved)

command DrawForm 0x0300 reserved {
  handle32[form] form;
  handle32[material_set] material_set;
  handle32[transform] transform;
  u8 viewport_mask;
  u8 semantic_weight;
  u16 flags;
}

command DrawPopulation 0x0301 reserved {
  handle32[population] population;
  u8 viewport_mask;
  u8 semantic_weight;
  u16 flags;
  pad[8];
}

command DrawProcedural 0x0302 reserved {
  handle32[forge_program] program;
  handle32[material] material;
  transform2fx transform;
  fx16 screen_error;
  pad[12];
}

// Sky pass (spec/sky_and_beams.md 4 — the W4 post-patch ABI reservation).
// Reserved: layout FROZEN, execution lands in wave 8. rot_proj is
// rotation-only per view (translation rows must be zero — validated when
// the command activates). flags: b0 under_plane, b1 cloud, b2 sun, b3 cap,
// b4 sun_glow_tag; b5..b7 reserved-0. reserved0/reserved1 must be zero.
// Opcodes 0x0311..0x031F are reserved for sky extensions — never allocate
// one without a spec/sky_and_beams.md version bump.
command DrawSky 0x0310 reserved {
  handle32[sky_set] sky_set;   // sky asset set (bands/cap/under/clouds/sun)
  mat4fx rot_proj[2];          // per-view rotation-only view-projection
  fx16 cloud_scroll_u;         // cloud sheet scroll offset, u axis (turns of the sheet)
  fx16 cloud_scroll_v;         // cloud sheet scroll offset, v axis
  angle16 drum_yaw;            // sky drum yaw (U 0.0.16 turns, qformats.md 2)
  u8 viewport_mask;            // which viewports this sky applies to
  u8 flags;                    // layer enable bits (see above)
  u8 reserved0;                // must be 0
  u8 reserved1;                // must be 0
  pad[14];                     // to the 16-B record alignment (176 B record)
}

// ---- audio (reserved)

command EmitAudioEvent 0x0400 reserved {
  u32 event_id;
  i16 pan_fx;
  u16 gain;
  u32 sample_handle;
  u32 timestamp;
}

// ---- bootstrap / debug umbrella (never game-facing; header flags bit0 required)

command DebugBootstrap 0xF001 reserved {
  u8 data[48];
}

// ABI v2 (wave 2): the two debug commands the console shell EXECUTES (plan
// W2.1/D8 — Phase-2 sinks of the CMD.SCHEDULER dispatch interface). Still
// never game-facing: a frame containing them MUST set header flags bit0.
// Wire layout (incl. reserved bytes as declared pads, so the validator
// zero-checks them per capture_format.md 1.1 rule 5):
//   dst_slot @0 u8, mode @1 video_mode, rsv @2 (2 B pad),
//   src_addr_hps @4 u32, byte_len @8 u32, expected_crc32c @12 u32,
//   rsv2+align @16 (16 B pad) — 32-B payload, 48-B record.
command DebugFrameBlit 0xF002 implemented {
  u8 dst_slot;          // framebuffer slot 0/1 the blit targets
  video_mode mode;      // mode the blit payload is laid out for
  pad[2];               // rsv
  u32 src_addr_hps;     // HPS-side source address (byte granule)
  u32 byte_len;         // blit length in bytes (must equal mode canvas bytes)
  u32 expected_crc32c;  // CRC-32C over the blit payload, checked pre-commit
  pad[16];              // rsv2 (u32) + 12-B alignment pad
}

// ABI v2 (wave 2): rumble request from the sealed frame (plan W2.1). One
// update per frame is applied (INPUT.RUMBLE latch law, spec/input_rules.md).
command DebugRumble 0xF004 implemented {
  u8 pad_index;   // 0-3
  u8 enable;      // 0 = stop, nonzero = run
  u8 strength;    // PWM duty numerator (duty = strength/256)
  pad[13];        // rsv byte + 12-B alignment pad — 16-B payload, 32-B record
}
