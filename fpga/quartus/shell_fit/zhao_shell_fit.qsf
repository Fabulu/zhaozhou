# ---- the UNPACKED ARRAY ports, element by element --------------------------
# Ten of the shell's ports are arrays -- `input logic [1:0] hps_state_i [0:2]`
# and friends. Quartus expands those into hps_state_i[0], [1], [2], and a
# VIRTUAL_PIN written against the bare name does not match the expansion.
#
# With the bare names alone the fitter still reported
#   Error (179000): Design requires 156 user-specified I/O pins -- too many
#                   to fit in the 145 user I/O pin locations available
# down from 742, so the bare names DID cover every ordinary port. These are the
# remainder. Named per element, because the wildcard is forbidden.
set_instance_assignment -name VIRTUAL_PIN ON -to hps_state_i[0]
set_instance_assignment -name VIRTUAL_PIN ON -to hps_state_i[1]
set_instance_assignment -name VIRTUAL_PIN ON -to hps_state_i[2]
set_instance_assignment -name VIRTUAL_PIN ON -to hps_byte_len_i[0]
set_instance_assignment -name VIRTUAL_PIN ON -to hps_byte_len_i[1]
set_instance_assignment -name VIRTUAL_PIN ON -to hps_byte_len_i[2]
