set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/raster/zhao_raster_fill.sv
# ---- D22 staircase: blocks the shell BENCH composes ------------------------
# Not instantiated by zhao_shell_top -- tb_zhao_shell instantiates them so the
# shell's input boundary can move backwards one block at a time and the same
# triangle be drawn both ways. Listed here anyway, because of the gate that
# caught their absence:
#
#   "A module missing from the QSF builds and tests green under Verilator and
#    cannot be elaborated by Quartus at all."
#
# GEOM.SETUP (step 1) went into tests/CMakeLists.txt and NOT here, so
# source_list_parity had been failing since.
#
# THE ORDER MATTERS AND IS NOT DEPENDENCY ORDER. It is tests/CMakeLists.txt's
# order, index for index, because run_shell_fit.ps1 compares the two lists
# positionally and refuses to run the fit when they differ -- so a swap is
# green under Verilator and fatal at the fit. The parity gate checks the order
# too, and caught this on the first attempt.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/geometry/zhao_geom_setup.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/geometry/zhao_geom_project.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/geometry/zhao_geom_clip.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/geometry/zhao_geom_depthquant.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/raster/zhao_raster_rcp24_svc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/field/zhao_field_rcp24_rom.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/zhao_shell_top.sv
# Added 2026-08-21 with the DEBUG.FRAMEBLIT integration (steps 4-6). These three
# were wired into zhao_shell_top and the CMake source list, and NOT here -- so
# Verilator built the shell fine while Quartus could not resolve u_slotmgr at
# all, failing every block fit whose cone reaches the shell and blocking the
# composed fit outright.
#
# TWO SOURCE LISTS FOR ONE DESIGN is the defect. This QSF and the CMake
# ZHAO_SHELL_RTL list must name the same files; nothing checks that they do,
# which is why the drift went unnoticed until a fit was attempted.

# zhao_shell_top instantiates zhao_geom_bin_pipe and zhao_raster_fbwrite (the
# render client on client_req[2]). Until 2026-08-31 this project did not list
# them or their closure, so the composed fit could not have elaborated -- it
# would have failed on the first missing module. The shell cone gained the
# render path when it was wired in; the fit project did not follow it.
#
# This is the closure of those two, taken from ZHAO_GEOM_BIN_PIPE_SV in
# tests/CMakeLists.txt so the fit and the simulation lane compile the same
# set rather than two lists that drift.

# The simulation harness interface is intentionally virtual. This prevents the
# characterization project from inventing a package pinout or exhausting I/O;
# zhao_shell_top remains the top and its complete port/logic cone remains present.
#
# EVERY PORT NAMED, rather than `-to *`, and the reason is peak memory.
#
# A wildcard instance assignment is matched against EVERY NODE NAME IN THE
# DESIGN, not against the top-level ports it was meant for. So `-to *` made
# Quartus carry a VIRTUAL_PIN candidacy for every internal net in the cone,
# which is a database entry each and a pattern match each. The composed map
# committed 28.4 GB and thrashed against 24 GB of RAM (measured 2026-08-18) for
# a design whose whole cone is video, command, debug, input, audio and memory
# blocks -- no terrain, texture, geometry or raster. A few thousand ALMs should
# not need 28 GB, and the wildcard is the reason it did.
#
# These are the 101 ports of zhao_shell_top, generated from its declaration.
# Naming a bus applies the assignment to all of its bits. If the port list
# changes, regenerate: the source of truth is the module header, and a missing
# port becomes a real pin and fails the fit loudly rather than silently.
set_instance_assignment -name VIRTUAL_PIN ON -to gpu_clk
set_instance_assignment -name VIRTUAL_PIN ON -to vid_clk
set_instance_assignment -name VIRTUAL_PIN ON -to audio_clk
set_instance_assignment -name VIRTUAL_PIN ON -to rst_n
set_instance_assignment -name VIRTUAL_PIN ON -to hps_state_i
