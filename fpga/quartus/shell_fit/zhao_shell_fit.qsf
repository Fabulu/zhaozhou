set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_sdram_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_vram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_mem_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_hps_bridge.sv
