# Standalone Phase-2 shell characterization only.
# 5CSEBA6U23I7 is a PROVISIONAL capacity/timing target, not board truth.
# No framework files, PLLs, or physical pin assignments belong in this project.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY zhao_shell_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name SDC_FILE zhao_shell_fit.sdc
# Exclude generated verification-only open-array helpers from Quartus 17's
# parser; the shell cone uses the guarded synthesizable ABI declarations.
set_global_assignment -name VERILOG_MACRO "QUARTUS_SYNTHESIS=1"

# Reproducible fixed-seed characterization settings supported by Quartus 17.0.2.
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 1
set_global_assignment -name OPTIMIZATION_MODE "BALANCED"
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"

# Exact ZHAO_SHELL_RTL cone from tests/CMakeLists.txt, in the same order.
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/generated/zhao_abi_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/zhao_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_sdram_params_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_video_mode.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_video_framectl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_video_scaler.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_scanout_fetch.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_scanout_linebuf.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_scanout_serializer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/video/zhao_video_scanout.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/command/zhao_cmd_scheduler.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/command/zhao_cmd_dma.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/debug/zhao_debug_counters.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/debug/zhao_debug_crc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/input/zhao_input_snapshot.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/input/zhao_input_rumble.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/audio/zhao_audio_fifo.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_sdram_ctrl.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_vram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_mem_guard.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/memory/zhao_hps_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/common/zhao_shell_top.sv

# The simulation harness interface is intentionally virtual. This prevents the
# characterization project from inventing a package pinout or exhausting I/O;
# zhao_shell_top remains the top and its complete port/logic cone remains present.
#
# EVERY PORT NAMED, rather than `-to *`, and the reason is peak memory.
#
# A wildcard instance assignment is matched against EVERY NODE NAME IN THE
# DESIGN, not against the top-level ports it was meant for. So `-to *` made
# Quartus carry a VIRTUAL_PIN candidacy for every internal net in the cone,
# which is a database entry each and a pattern match each. The composed map
# committed 28.4 GB and thrashed against 24 GB of RAM (measured 2026-08-18) for
# a design whose whole cone is video, command, debug, input, audio and memory
# blocks -- no terrain, texture, geometry or raster. A few thousand ALMs should
# not need 28 GB, and the wildcard is the reason it did.
#
# These are the 101 ports of zhao_shell_top, generated from its declaration.
# Naming a bus applies the assignment to all of its bits. If the port list
# changes, regenerate: the source of truth is the module header, and a missing
# port becomes a real pin and fails the fit loudly rather than silently.
set_instance_assignment -name VIRTUAL_PIN ON -to gpu_clk
set_instance_assignment -name VIRTUAL_PIN ON -to vid_clk
set_instance_assignment -name VIRTUAL_PIN ON -to audio_clk
set_instance_assignment -name VIRTUAL_PIN ON -to rst_n
set_instance_assignment -name VIRTUAL_PIN ON -to hps_state_i
set_instance_assignment -name VIRTUAL_PIN ON -to hps_byte_len_i
set_instance_assignment -name VIRTUAL_PIN ON -to ring_wr_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to ring_wr_slot_o
set_instance_assignment -name VIRTUAL_PIN ON -to ring_wr_state_o
set_instance_assignment -name VIRTUAL_PIN ON -to ring_wr_ready_i
set_instance_assignment -name VIRTUAL_PIN ON -to hps_req_valid_o
set_instance_assignment -name VIRTUAL_PIN ON -to hps_req_write_o
set_instance_assignment -name VIRTUAL_PIN ON -to hps_req_addr_o
set_instance_assignment -name VIRTUAL_PIN ON -to hps_req_len_o
set_instance_assignment -name VIRTUAL_PIN ON -to hps_req_grant_i
