# Build output (CMake/Ninja build tree, synth images)
build/
build-*/
out/
*.bit
*.svf
*.asc
*.config
# NOTE: no global *.bin ignore — golden vector binaries (tests/golden/,
# tests/abi/golden/, captures/) are committed evidence, not build output.

# Quartus characterization products (projects and constraints stay tracked)
fpga/quartus/shell_fit/db/
fpga/quartus/shell_fit/incremental_db/
fpga/quartus/shell_fit/output_files/
fpga/quartus/shell_fit/greybox_tmp/
fpga/quartus/shell_fit/hc_output/
fpga/quartus/shell_fit/simulation/
fpga/quartus/shell_fit/*.qws
fpga/quartus/shell_fit/*.smsg

# Simulation artifacts
obj_dir/
*.vcd
*.fst
# NOTE: no global *.log ignore — evidence logs under reports/ are committed.
# Tool logs land in build/ (ignored above) or /tmp.

# Node
node_modules/
# TypeScript build output of the npm workspace tools (never committed)
dist/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# TS build output (fixgen tsc -> dist/, never committed)
# TS build outputs (tools/abi-gen, compiler): npm scripts rebuild on demand

# built binaries never committed
*.exe
.scratch-reel/
