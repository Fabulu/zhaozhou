# Build output (CMake/Ninja build tree, synth images)
build/
build-*/
out/
*.bit
*.svf
*.asc
*.config
# NOTE: no global *.bin ignore — golden vector binaries (tests/golden/,
# tests/abi/golden/, captures/) are committed evidence, not build output.

# Quartus characterization products (projects and constraints stay tracked)
fpga/quartus/shell_fit/db/
fpga/quartus/shell_fit/incremental_db/
fpga/quartus/shell_fit/output_files/
fpga/quartus/shell_fit/greybox_tmp/
fpga/quartus/shell_fit/hc_output/
fpga/quartus/shell_fit/simulation/
fpga/quartus/shell_fit/*.qws
fpga/quartus/shell_fit/*.smsg

# SymbiYosys work directories. The .sby harness and its _fv.sv are tracked
# evidence; the solver's scratch tree (config.sby copy, model/, engine_0/,
# logfile.txt, status) is regenerated by every run and is not.
tests/formal/*/

# Simulation artifacts
obj_dir/
*.vcd
*.fst
# NOTE: no global *.log ignore — evidence logs under reports/ are committed.
# Tool logs land in build/ (ignored above) or /tmp.

# Node
node_modules/
# TypeScript build output of the npm workspace tools (never committed)
dist/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# TS build output (fixgen tsc -> dist/, never committed)
# TS build outputs (tools/abi-gen, compiler): npm scripts rebuild on demand

# built binaries never committed
*.exe
.scratch-reel/

# Python bytecode from the sweep preflights
__pycache__/
.sweep_field_dsp.lock
gate.log
sweep_*.log
pf.txt
.ccache/

# ---------------------------------------------------------------------------
# RAW RENDER FRAMES AND RUN WORKING DATA — never committed.
#
# Added 2026-08-28 after an over-broad `git add` swept 867 raw .rgb frames into
# three commits and the owner had to authorise a history rewrite to remove them.
# THE EVIDENCE IS THE PNG CONTACT SHEET, NOT THE FRAMES IT WAS MADE FROM.
# A run's evidence/*.png is committed and belongs in history; the raw frames,
# object files and golden staging dirs are regenerable working data.
# ---------------------------------------------------------------------------
*.rgb
runs/**/renders/
runs/**/renders-baseline/
runs/**/scratch/
runs/**/obj/
runs/**/golden-work/
runs/**/golden-verify/
# scratch reel output, wherever a subject dir lands
**/scratch-reel/
tools/reel/exp/

# Nested clones an agent made inside a run work dir. They were committed as
# GITLINKS with no .gitmodules entry, so every CI checkout ran
# `git submodule foreach` against them and exited 128 -- a warning on every
# single job. They are working clones of sibling repos, never our content.
runs/CLAUDE-RUNS/RUN-20260829-0525-zixxtrixx-v9-cel-main-art-pass/work/Upheaval/
runs/CLAUDE-RUNS/RUN-20260829-0525-zixxtrixx-v9-cel-main-art-pass/work/zhaozhou-v9/
runs/CLAUDE-RUNS/RUN-20260829-2226-zixxtrixx-v10-lighting-spring-repair/work/Upheaval-v10/
runs/CLAUDE-RUNS/RUN-20260829-2226-zixxtrixx-v10-lighting-spring-repair/work/zhaozhou-v10/
runs/CLAUDE-RUNS/RUN-20260830-0329-creature-authoring-blueprint/work/Upheaval-blueprint/
runs/CLAUDE-RUNS/RUN-20260830-0329-creature-authoring-blueprint/work/zhaozhou-blueprint/
