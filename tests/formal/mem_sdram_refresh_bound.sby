# mem_sdram_refresh_bound.sby — BANKED evidence (plan W2.5; MEM.SDRAM stays
# SPECIFIED, blocked_on: hardware). Under fully adversarial client pressure
# and an adversarial hold_refresh, AUTO_REFRESH commands are bounded-deferred:
# never more than INTERVAL + URGENT + spans + execution cycles apart.
# Run with cwd = tests/formal.
#
# NOT IN THE AUTOMATED LANE (see tests/CMakeLists.txt). depth 900 is forced by
# the bound itself (~862 cycles), and now that the environment is genuinely
# free rather than elaborating to constants the tasks cost real time. Measured
# 2026-08-15, first time this property was ever actually elaborated:
#   cover : PASSES in ~11 min — all three covers reached (init_done at step 28,
#           since_ref > 100 at step 129, a real AUTO_REFRESH at step 812), so
#           the bound is NOT a vacuous implication on init_done.
#   bmc   : still running after 50 min; NOT ESTABLISHED. Not a failure — an
#           unfinished proof.
# Run by hand:  sby -f --prefix <dir> mem_sdram_refresh_bound.sby
# The harness defects it shared with the other two MEM properties (free rst_n,
# non-surviving anyseq) are fixed here.
# Frontend: read_slang. The built-in yosys Verilog reader cannot parse the
# frozen package style (unpacked-array localparams, `module X import P::*;`),
# which is why this lane used to SKIP; the slang plugin shipped with
# oss-cad-suite reads these same frozen packages, so the SKIP was never
# actually necessary.
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 900
cover: mode cover
cover: depth 900
expect pass
[engines]
smtbmc boolector
[script]
read_slang --top formal_mem_refresh zhao_abi_pkg.sv zhao_pkg.sv zhao_sdram_params_pkg.sv zhao_sdram_ctrl.sv formal_mem_refresh.sv
prep -top formal_mem_refresh
[files]
../../fpga/rtl/generated/zhao_abi_pkg.sv
../../fpga/rtl/common/zhao_pkg.sv
../../fpga/rtl/memory/zhao_sdram_params_pkg.sv
../../fpga/rtl/memory/zhao_sdram_ctrl.sv
formal_mem_refresh.sv
