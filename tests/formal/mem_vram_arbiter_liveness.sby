# mem_vram_arbiter_liveness.sby — D3 liveness bound (plan W2.5 / plan 4).
# The composed arbiter+controller (real RTL, no memory model) serves every
# guaranteed client's first SDRAM-edge burst within B = 40 cycles of port
# acceptance, under the documented Phase-2 population assumptions (G=2).
# Run with cwd = tests/formal (the CTest wrapper and the docs both do).
# Frontend: read_slang. The built-in yosys Verilog reader cannot parse the
# frozen package style (unpacked-array localparams, `module X import P::*;`),
# which is why this lane used to SKIP; the slang plugin shipped with
# oss-cad-suite reads these same frozen packages, so the SKIP was never
# actually necessary.
[tasks]
bmc
cover

[options]
bmc: mode bmc
bmc: depth 130
cover: mode cover
cover: depth 130
expect pass
[engines]
smtbmc boolector
[script]
read_slang --top formal_mem_arbiter zhao_abi_pkg.sv zhao_pkg.sv zhao_sdram_params_pkg.sv zhao_sdram_ctrl.sv zhao_vram_arbiter.sv formal_mem_arbiter.sv
prep -top formal_mem_arbiter
[files]
../../fpga/rtl/generated/zhao_abi_pkg.sv
../../fpga/rtl/common/zhao_pkg.sv
../../fpga/rtl/memory/zhao_sdram_params_pkg.sv
../../fpga/rtl/memory/zhao_sdram_ctrl.sv
../../fpga/rtl/memory/zhao_vram_arbiter.sv
formal_mem_arbiter.sv
