# mem_formal_lane.cmake — CTest wrapper for one W2.5 SBY property.
#
# Every path below is substituted at CONFIGURE time (@ONLY): script-mode
# cmake has no reliable CMAKE_CURRENT_BINARY_DIR, and the sby work dir is
# kept SEPARATE from the lane scripts' directory so no run can ever touch
# them.
#
# SKIP POLICY — deliberately narrow.
# The previous version SKIPped on ANY log line matching "syntax error". That
# matched every parse failure there is, in any file, forever: a property could
# rot, or never have been elaborated even once, and the lane would stay green
# and say "ready". It did exactly that — the MEM properties had never been
# elaborated at all, and the guard's assertions were vacuous underneath the
# SKIP. The .sby scripts now use `read_slang`, which parses the frozen package
# style perfectly well (the INPUT lane has used it since W2.3), so the
# toolchain gap the SKIP described does not exist for this lane.
#
# The ONLY remaining legitimate SKIP is a yosys build with no slang plugin at
# all, which fails with a specific and unmistakable signature. Anything else —
# any parse error, any failing assertion, any unreachable cover — is FATAL.

if("@ZHAO_SBY_BIN@" STREQUAL "")
  message(STATUS "sby not found — formal lane SKIPPED")
  return()
endif()

# PATH order matters on this kit (the same pitfall the INPUT and AUDIO lane
# wrappers already document, missing here): the suite's yosys resolves its
# DLLs from bin/../lib, and a mingw toolchain earlier in PATH shadows them
# with an incompatible libstdc++, so yosys dies with STATUS_ENTRYPOINT_NOT_
# FOUND (0xC0000139) before it parses a single line. That is a "never
# elaborated" failure wearing a tooling costume — it hard-fails below rather
# than SKIPping, but it should not happen at all. Prepend the suite dirs.
get_filename_component(zhao_sby_dir "@ZHAO_SBY_BIN@" DIRECTORY)
set(ENV{PATH} "${zhao_sby_dir}\;${zhao_sby_dir}/../lib\;$ENV{PATH}")

set(workdir "@FORMAL_WORK_ROOT@/@PROP@")
file(REMOVE_RECURSE "${workdir}")
file(MAKE_DIRECTORY "${workdir}")

# --prefix (not -d): these properties carry multiple tasks (bmc AND cover),
# and the cover task is load-bearing — it is what proves the bmc task is not
# passing vacuously.
execute_process(
  COMMAND "@ZHAO_SBY_BIN@" -f --prefix "${workdir}" "@PROP@.sby"
  WORKING_DIRECTORY "@FORMAL_SRC_DIR@"
  RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _out
  ERROR_VARIABLE _err
  # THE WRAPPER'S BUDGET, and it is the one that BINDS. Parameterised
  # 2026-08-23 because it silently outranked a CTest property that had been
  # raised deliberately: formal_texture_bilerp carries `TIMEOUT 3600` with a
  # comment explaining that its bmc task measures 1,264 s and needs headroom --
  # and then died at 1,800.88 s, killed by this line, reported as a FAILED
  # test rather than as a timeout. A budget stated in one file and enforced in
  # another is not a budget.
  #
  # Default unchanged at 1800 so every lane that does not set it behaves
  # exactly as before.
  TIMEOUT @ZHAO_FORMAL_WRAPPER_TIMEOUT@
)
if(_rc EQUAL 0)
  message(STATUS "formal @PROP@: PASS (bmc + cover)")
  return()
endif()

# The one pinned SKIP signature: yosys has no read_slang command, i.e. the
# slang frontend plugin is absent from this toolchain build. Nothing else.
set(_gap FALSE)
if(_out MATCHES "No such command: read_slang" OR _err MATCHES "No such command: read_slang"
   OR _out MATCHES "Can't open plugin" OR _err MATCHES "Can't open plugin")
  set(_gap TRUE)
endif()

if(_gap)
  message(STATUS "formal lane SKIPPED: this yosys build has no read_slang (slang plugin absent) — property @PROP@ is ready and runs on a toolchain that ships it")
  return()
endif()

message(FATAL_ERROR "sby @PROP@ FAILED (rc=${_rc}):\n${_out}\n${_err}")
