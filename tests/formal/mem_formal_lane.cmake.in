# mem_formal_lane.cmake — CTest wrapper for one W2.5 SBY property.
# Same SKIP-if-absent law as the W1 formal lane smoke: `ctest -L formal`
# stays green on machines without the tools.
#
# Every path below is substituted at CONFIGURE time (@ONLY): script-mode
# cmake has no reliable CMAKE_CURRENT_BINARY_DIR, and the sby work dir is
# kept SEPARATE from the lane scripts' directory so no run can ever touch
# them.
#
# KNOWN TOOLCHAIN GAP (documented in the wave-2 TASK_LOG): the oss-cad-suite
# yosys SV frontend cannot parse the FROZEN interface-package style this
# codebase is written in (unpacked-array localparams like ZHAO_CRC32C_TABLE /
# ZHAO_TIMING, and `module X import P::*;` header imports). When sby fails
# with exactly that parse signature the lane SKIPs (the .sby + harness are
# ready and correct; they run when the toolchain integrates UHDM/Surelog or
# on the hardware lane). Any other failure is FATAL.

if("@ZHAO_SBY_BIN@" STREQUAL "")
  message(STATUS "sby not found — formal lane SKIPPED")
  return()
endif()

set(workdir "@FORMAL_WORK_ROOT@/@PROP@")
file(REMOVE_RECURSE "${workdir}")
file(MAKE_DIRECTORY "${workdir}")

execute_process(
  COMMAND "@ZHAO_SBY_BIN@" -f -d "${workdir}" "@PROP@.sby"
  WORKING_DIRECTORY "@FORMAL_SRC_DIR@"
  RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _out
  ERROR_VARIABLE _err
  TIMEOUT 880
)
if(_rc EQUAL 0)
  message(STATUS "formal @PROP@: PASS")
  return()
endif()

# toolchain-gap detection: yosys frontend vs the frozen package style
set(_log "${workdir}/model/design.log")
set(_gap FALSE)
if(EXISTS "${_log}")
  file(READ "${_log}" _design)
  if(_design MATCHES "syntax error, unexpected")
    set(_gap TRUE)
  endif()
endif()
if(NOT _gap AND (_out MATCHES "syntax error" OR _err MATCHES "syntax error"))
  set(_gap TRUE)
endif()

if(_gap)
  message(STATUS "formal lane SKIPPED: yosys SV frontend cannot parse the frozen zhao_pkg style (see wrapper header) — property @PROP@ is ready and reruns on an integrated toolchain")
  return()
endif()

message(FATAL_ERROR "sby @PROP@ FAILED (rc=${_rc}):\n${_out}\n${_err}")
