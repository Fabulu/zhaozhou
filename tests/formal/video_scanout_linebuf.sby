# video_scanout_linebuf.sby — VIDEO.SCANOUT line-buffer formal properties
# (plan W2.2 §4; spec/video_rules.md §8: the serializer never overtakes the
# fill — a FRESH buffer's read port returns exactly its last completed
# fill; never torn).
#
# The linebuf module is checked in ISOLATION with the FETCH and DISPLAY
# protocol as assumptions (an abstract adversarial driver respecting the
# handshake: fill only EMPTY buffers, one line at a time, complete before
# line_done; consume only FRESH buffers) — the full-system vblank-swap law
# is proven cycle-exactly by the differential tests. Clocks tied
# (gpu_clk = vid_clk): the crossing degenerates to a fixed delay.
#
# TWO TASKS, both required (ledger rule V16):
#   bmc   — the never-torn symbolic-address equivalence, BOUNDED AT DEPTH 8
#           and self-asserting about it (a_scope_four_sessions in the
#           harness fires if the depth is ever raised past what this run
#           proved — the arbiter a_horizon_is_refresh_free pattern).
#           COVERS: up to four completed fill sessions = every CEX class
#           this property has produced (the abort-blip torn read at step
#           6 — a REAL contract violation, now fenced by the documented
#           system spacing law; the credit round-trip and simultaneous
#           both-buffers-fresh at step 8).
#           DOES NOT COVER: interleavings needing a fifth completion.
#           WHY BOUNDED: each BMC step past 7 costs ~10 solver-minutes
#           (solo box, boolector AND yices, zero-init storage, 1-bit data
#           alphabet) — depth 30 is hours, not a lane task. The unbounded
#           law stays covered cycle-exactly by the scanout differentials.
#   cover — buf_fresh[rd_buf] (THE assertion antecedent), ping-pong overlap,
#           the credit round-trip, the abort-discard path (the salvaged
#           harness had NO covers — freshness could simply never rise).
#
# Run via `ctest -L formal` (shared hardened wrapper) or by hand:
#   sby -f --prefix <workdir> video_scanout_linebuf.sby

[tasks]
bmc
cover

[options]
bmc:   mode bmc
bmc:   depth 8
cover: mode cover
cover: depth 40
expect pass

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang --top video_linebuf_fv -DFORMAL zhao_abi_pkg.sv zhao_pkg.sv zhao_dc_sdp_ram.sv zhao_scanout_linebuf.sv video_linebuf_fv.sv
prep -top video_linebuf_fv

