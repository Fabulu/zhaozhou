# lint_stub.cmake — CTest wrapper: verilator --lint-only -Wall over the
# stub RTL. Runs in script mode (-P); configured from tests/CMakeLists.txt.
# Machine pins (P1 findings 3): invoke verilator_bin(.exe) directly; the perl
# wrapper `verilator` has no bundled perl; VERILATOR_ROOT must point at the
# suite's share/verilator.

set(ENV{VERILATOR_ROOT} "@VERILATOR_ROOT@")
set(_stub_dir "@CMAKE_SOURCE_DIR@/fpga/rtl/common")

execute_process(
  COMMAND "@ZHAO_VERILATOR_BIN@"
          --lint-only -Wall
          ${_stub_dir}/zhao_frame_pkg.sv
          ${_stub_dir}/zhao_stub_top.sv
  RESULT_VARIABLE _rc
  OUTPUT_VARIABLE _out
  ERROR_VARIABLE _out
)
if(_out)
  message(STATUS "verilator lint output:\n${_out}")
endif()
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "verilator --lint-only -Wall FAILED (rc=${_rc}) on zhao_stub_top.sv")
endif()
message(STATUS "verilator lint clean: zhao_stub_top.sv (-Wall)")
