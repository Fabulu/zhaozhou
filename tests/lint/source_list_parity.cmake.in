# source_list_parity.cmake — the shell has ONE file list, not two.
#
# WHY THIS EXISTS. Step 4 of the DEBUG.FRAMEBLIT integration wired
# zhao_debug_frameblit, zhao_hps_arbiter and zhao_video_slotmgr into
# zhao_shell_top and added them to tests/CMakeLists.txt — the list Verilator
# reads. It did NOT add them to fpga/quartus/shell_fit/zhao_shell_fit.qsf, the
# list Quartus reads.
#
# So Verilator built and tested the composed shell for hours, green, while
# Quartus could not resolve `u_slotmgr` at all:
#
#   Error (10703): zhao_shell_top.sv(864): can't resolve aggregate expression
#   in connection to port 20 on instance "u_slotmgr" because the instance has
#   no module binding
#
# That failed every per-block fit whose source cone reaches the shell, and it
# would have failed the composed fit outright. It was found only because a fit
# was attempted for an unrelated reason.
#
# TWO SOURCE LISTS FOR ONE DESIGN is the defect, and it is the same shape as
# the OP_ABS defect and the wrong TERRAIN.LOD contract: two statements of one
# fact, no check that they agree, and the one that is not exercised rots. Here
# the two are not even documents — they are two toolchains, which is why the
# green suite proved nothing about the synthesis lane.
#
# It asserts the SETS match AND that they are in the SAME ORDER.
#
# ORDER WAS ADDED 2026-08-22, and the reason is that leaving it out cost a fit
# run. This gate originally checked sets only, on the stated reasoning that
# "Quartus needs an ORDER, CMake does not". That is true of the tools and false
# of the project: tools/quartus/run_shell_fit.ps1 refuses to run unless the two
# lists match INDEX BY INDEX --
#
#   Shell source parity failed at index 23:
#     CMake='fpga/rtl/debug/zhao_debug_frameblit.sv',
#     QSF='fpga/rtl/video/zhao_video_slotmgr.sv'
#
# -- so a swapped pair passed ctest green and stopped the composed fit before
# it reached Quartus at all. A gate that checks less than the thing it guards
# is the same defect it was written to catch: two statements of one fact, and
# the weaker one rots.
#
# zhao_abi_pkg is still excluded, and excluding it cannot hide an ordering
# error among the rest: removing one element preserves the relative order of
# every other.
set(_qsf "@CMAKE_SOURCE_DIR@/fpga/quartus/shell_fit/zhao_shell_fit.qsf")
set(_cml "@CMAKE_SOURCE_DIR@/tests/CMakeLists.txt")

foreach(_f "${_qsf}" "${_cml}")
  if(NOT EXISTS "${_f}")
    message(FATAL_ERROR "source-list parity: missing ${_f}")
  endif()
endforeach()

# ---- the QSF's SystemVerilog files, basenames -----------------------------
file(READ "${_qsf}" _qsf_text)
string(REGEX MATCHALL "SYSTEMVERILOG_FILE[ \t]+[^\r\n]+" _qsf_lines "${_qsf_text}")
set(_qsf_names "")
set(_qsf_lines_kept "")
foreach(_line IN LISTS _qsf_lines)
  if(_line MATCHES "([A-Za-z0-9_]+)\\.sv")
    list(APPEND _qsf_names "${CMAKE_MATCH_1}")
    list(APPEND _qsf_lines_kept "${_line}")
  endif()
endforeach()

# ---- the CMake ZHAO_SHELL_RTL list, basenames -----------------------------
file(READ "${_cml}" _cml_text)
string(FIND "${_cml_text}" "set(ZHAO_SHELL_RTL" _i)
if(_i EQUAL -1)
  message(FATAL_ERROR "source-list parity: ZHAO_SHELL_RTL not found in tests/CMakeLists.txt")
endif()
# TO THE END OF THE FILE, not a fixed window.
#
# This read 4000 characters. On 2026-09-05 the ZHAO_SHELL_RTL block reached
# 4,242 characters as the D22 staircase added blocks and the comments
# explaining them -- so the last 242 characters, which is to say the last FOUR
# modules, fell outside the window and the check reported them "in the QSF but
# NOT in tests/CMakeLists.txt". A true statement about the text it read and a
# false one about the file.
#
# It failed loudly, which is the good direction, but it failed for a reason
# that has nothing to do with what it is guarding: the lists were identical.
# A gate whose own reading window is a magic number will eventually fire on
# its own growth, and the person who sees it will start by editing the QSF.
string(SUBSTRING "${_cml_text}" ${_i} -1 _tail)
string(FIND "${_tail}" ")" _j)
string(SUBSTRING "${_tail}" 0 ${_j} _block)
string(REGEX MATCHALL "fpga/rtl/[^ \t\r\n)]+\\.sv" _cml_paths "${_block}")
set(_cml_names "")
foreach(_p IN LISTS _cml_paths)
  if(_p MATCHES "([A-Za-z0-9_]+)\\.sv")
    list(APPEND _cml_names "${CMAKE_MATCH_1}")
  endif()
endforeach()

if(NOT _qsf_names OR NOT _cml_names)
  message(FATAL_ERROR "source-list parity: parsed an empty list (qsf=${_qsf_names} cmake=${_cml_names})")
endif()

# ---- the generated FIT WRAPPER is the second sanctioned asymmetry ---------
#
# Added 2026-09-16, after this gate had been red since the shell-fit top was
# split out. `zhao_shell_fit_top` is a Quartus-ONLY wrapper: it is generated by
# tools/quartus/gen_shell_fit_top.py, it instantiates `zhao_shell_top` and
# nothing instantiates it, and it exists to give the fit a pin-bearing top. The
# Verilator lane elaborates `zhao_shell_top` directly and must never see it.
#
# So the two lists are not equal and were never meant to be. The authority on
# what they should be is tools/quartus/shell_fit_qsf.py, the preflight that
# actually refuses to start the fit, and it is unambiguous:
#
#     expected_sources=(*pool, wrapper)
#
# -- the CMake pool, then the wrapper, appended last. This gate was asserting a
# rule the gate it guards does not hold, which is the same two-statements-of-
# one-fact defect the header above describes, with this file now the stale one.
#
# THE EXCLUSION IS EARNED, NOT GRANTED. Removing a name because it is
# inconvenient is how an exclusion list becomes the place drift hides. What is
# checked here is strictly MORE than before: the QSF's last SystemVerilog file
# must be the TOP_LEVEL_ENTITY, must live under fpga/rtl/generated/, and must
# not appear in the Verilator list at all. A hand-written module dropped in
# under that name, a wrapper that stops being last, or a top that starts being
# verilated all still fail.
if(NOT _qsf_text MATCHES "TOP_LEVEL_ENTITY[ \t]+([A-Za-z0-9_]+)")
  message(FATAL_ERROR "source-list parity: the QSF declares no TOP_LEVEL_ENTITY")
endif()
set(_top "${CMAKE_MATCH_1}")

list(LENGTH _qsf_names _nq_raw)
math(EXPR _lastq "${_nq_raw} - 1")
list(GET _qsf_names ${_lastq} _qsf_last)
list(GET _qsf_lines_kept ${_lastq} _qsf_last_line)

if(NOT _top STREQUAL _qsf_last)
  message(FATAL_ERROR
    "source-list parity: the QSF's TOP_LEVEL_ENTITY is '${_top}' but its LAST "
    "SystemVerilog file is '${_qsf_last}'. Quartus needs leaves before the "
    "top, and tools/quartus/shell_fit_qsf.py appends the generated wrapper "
    "last; a top that is not last means the list is not in dependency order.")
endif()
if(NOT _qsf_last_line MATCHES "rtl/generated/")
  message(FATAL_ERROR
    "source-list parity: the QSF's top '${_top}' is not under "
    "fpga/rtl/generated/. Only the GENERATED fit wrapper may be absent from "
    "the Verilator list; a hand-written top must be verilated too.")
endif()
list(FIND _cml_names "${_top}" _top_in_cml)
if(NOT _top_in_cml EQUAL -1)
  message(FATAL_ERROR
    "source-list parity: the generated fit wrapper '${_top}' appears in "
    "tests/CMakeLists.txt. It wraps zhao_shell_top for Quartus only; "
    "verilating it elaborates the shell twice.")
endif()
list(REMOVE_AT _qsf_names ${_lastq})

list(REMOVE_DUPLICATES _qsf_names)
list(REMOVE_DUPLICATES _cml_names)

# zhao_abi_pkg is generated and reaches the Verilator lane by its own path, so
# it is expected in the QSF only. Neither removal can hide an ordering error
# among the rest: dropping elements preserves the relative order of every
# other.
list(REMOVE_ITEM _qsf_names "zhao_abi_pkg")

set(_only_cmake "${_cml_names}")
list(REMOVE_ITEM _only_cmake ${_qsf_names})
set(_only_qsf "${_qsf_names}")
list(REMOVE_ITEM _only_qsf ${_cml_names})

if(_only_cmake OR _only_qsf)
  message(FATAL_ERROR
    "SHELL SOURCE LISTS DISAGREE.\n"
    "  in tests/CMakeLists.txt but NOT in the Quartus QSF: ${_only_cmake}\n"
    "  in the Quartus QSF but NOT in tests/CMakeLists.txt: ${_only_qsf}\n"
    "A module missing from the QSF builds and tests green under Verilator and "
    "cannot be elaborated by Quartus at all. Add it to "
    "fpga/quartus/shell_fit/zhao_shell_fit.qsf in dependency order (leaves "
    "before the shell), or to tests/CMakeLists.txt, so both toolchains see the "
    "same design.")
endif()

# ---- and in the SAME ORDER ------------------------------------------------
list(LENGTH _cml_names _n)
list(LENGTH _qsf_names _nq)
if(NOT _n EQUAL _nq)
  message(FATAL_ERROR
    "source-list parity: ${_n} modules in CMake, ${_nq} in the QSF after "
    "removing the sanctioned zhao_abi_pkg asymmetry.")
endif()

math(EXPR _last "${_n} - 1")
foreach(_i RANGE ${_last})
  list(GET _cml_names ${_i} _a)
  list(GET _qsf_names ${_i} _b)
  if(NOT _a STREQUAL _b)
    message(FATAL_ERROR
      "SHELL SOURCE LISTS ARE IN A DIFFERENT ORDER.
"
      "  index ${_i}: tests/CMakeLists.txt has '${_a}', the QSF has '${_b}'
"
      "tools/quartus/run_shell_fit.ps1 compares these two lists index by index "
      "and refuses to run the fit when they differ, so an ordering swap is "
      "green here and fatal there. Reorder the QSF to match "
      "tests/CMakeLists.txt (leaves before the shell).")
  endif()
endforeach()

message(STATUS "source-list parity OK: ${_n} shell modules, same set and same order")
